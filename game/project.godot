; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="终末旅行"
run/main_scene="res://scenes/menu/main_menu.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

MusicManager="*res://scripts/autoload/music_manager.gd"
GameManager="*res://scripts/autoload/game_manager.gd"
RunTransition="*res://scripts/autoload/run_transition.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
MetaManager="*res://scripts/autoload/meta_manager.gd"
JournalData="*res://scripts/autoload/journal_data.gd"
StoryData="*res://scripts/autoload/story_data.gd"
SettingsManager="*res://scripts/autoload/settings_manager.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[global_script_class_icons]

DayTopdownRender=""

[global_script_classes]

global_script_classes=[{
"base": &"RefCounted",
"class": &"DayTopdownRender",
"icon": "",
"language": &"GDScript",
"path": "res://scripts/day_topdown_render.gd"
}, {
"base": &"RefCounted",
"class": &"HudTheme",
"icon": "",
"language": &"GDScript",
"path": "res://scripts/ui/hud_theme.gd"
}, {
"base": &"Control",
"class": &"PdaHudPanel",
"icon": "",
"language": &"GDScript",
"path": "res://scripts/ui/pda_hud_panel.gd"
}]

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.0431373, 0.0627451, 0.0941176, 1)
