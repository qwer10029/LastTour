; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="终末旅行"
run/main_scene="res://scenes/menu/main_menu.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://scripts/autoload/game_manager.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
MetaManager="*res://scripts/autoload/meta_manager.gd"
EvidenceData="*res://scripts/autoload/evidence_data.gd"

[display]

window/size/mode=2
window/size/initial_position_type=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[global_script_class_icons]

DayTopdownRender=""

[global_script_classes]

global_script_classes=[{
"base": &"RefCounted",
"class": &"DayTopdownRender",
"icon": "",
"language": &"GDScript",
"path": "res://scripts/day_topdown_render.gd"
}, {
"base": &"RefCounted",
"class": &"HudTheme",
"icon": "",
"language": &"GDScript",
"path": "res://scripts/ui/hud_theme.gd"
}, {
"base": &"Control",
"class": &"PdaHudPanel",
"icon": "",
"language": &"GDScript",
"path": "res://scripts/ui/pda_hud_panel.gd"
}]

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
